+  SUBROUTINE copy_Hubbard_ns_array(dest, dest_ispresent, dest_ndim, src, src_ispresent, src_ndim)
+    IMPLICIT NONE
+    TYPE(Hubbard_ns_type), DIMENSION(:), ALLOCATABLE, INTENT(INOUT) :: dest
+    LOGICAL, INTENT(INOUT) :: dest_ispresent
+    INTEGER, INTENT(INOUT) :: dest_ndim
+    TYPE(Hubbard_ns_type), DIMENSION(:), ALLOCATABLE, INTENT(IN) :: src
+    LOGICAL, INTENT(IN) :: src_ispresent
+    INTEGER, INTENT(IN) :: src_ndim
+    INTEGER :: i, n
+    !
+    IF (ALLOCATED(dest)) DEALLOCATE(dest)
+    dest_ispresent = src_ispresent
+    dest_ndim = src_ndim
+    IF (src_ispresent .AND. ALLOCATED(src)) THEN
+      n = SIZE(src)
+      ALLOCATE(dest(n))
+      DO i = 1, n
+        dest(i)%tagname = src(i)%tagname
+        dest(i)%lwrite  = src(i)%lwrite
+        dest(i)%lread   = src(i)%lread
+        dest(i)%rank    = src(i)%rank
+        dest(i)%order   = src(i)%order
+        dest(i)%order_ispresent = src(i)%order_ispresent
+        dest(i)%specie  = src(i)%specie
+        dest(i)%specie_ispresent = src(i)%specie_ispresent
+        dest(i)%label   = src(i)%label
+        dest(i)%label_ispresent = src(i)%label_ispresent
+        dest(i)%spin    = src(i)%spin
+        dest(i)%spin_ispresent = src(i)%spin_ispresent
+        dest(i)%index   = src(i)%index
+        dest(i)%index_ispresent = src(i)%index_ispresent
+        IF (ALLOCATED(src(i)%dims)) THEN
+          IF (ALLOCATED(dest(i)%dims)) DEALLOCATE(dest(i)%dims)
+          ALLOCATE(dest(i)%dims(SIZE(src(i)%dims)))
+          dest(i)%dims = src(i)%dims
+        END IF
+        IF (ALLOCATED(src(i)%Hubbard_ns)) THEN
+          IF (ALLOCATED(dest(i)%Hubbard_ns)) DEALLOCATE(dest(i)%Hubbard_ns)
+          ALLOCATE(dest(i)%Hubbard_ns(SIZE(src(i)%Hubbard_ns)))
+          dest(i)%Hubbard_ns = src(i)%Hubbard_ns
+        END IF
+      END DO
+    END IF
+  END SUBROUTINE copy_Hubbard_ns_array

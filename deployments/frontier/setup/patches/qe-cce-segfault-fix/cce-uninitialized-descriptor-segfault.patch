   !
+  ! ---------------------------------------------------------------------------
+  ! Frontier/cce-18.0.1 workaround: plain derived-type assignment of dftU_type
+  ! and vdW_type (e.g. "obj%dftU = dftU") crashes with a SIGSEGV inside the
+  ! Cray Fortran runtime (_F90_COPY_POLYMORPHIC / alloc_cpnts / __single_dealloc
+  ! / omp_free in libf.so.2), even though neither type is actually polymorphic.
+  !
+  ! Below, every array component is copied manually, field by field, via plain
+  ! ALLOCATE + scalar/fixed-array assignment only -- never via compiler-
+  ! synthesized structure assignment, SOURCE= allocation, or whole-array
+  ! intrinsic derived-type copy, all of which route through the same buggy
+  ! runtime path. This is safe now that the root descriptor-initialization bug
+  ! (see the SAVE comment in pw_init_qexsd_input.f90) is fixed at its source,
+  ! so src's *_ispresent flags and ALLOCATED() status can be trusted here.
+  ! ---------------------------------------------------------------------------
+  SUBROUTINE qes_safe_copy_dftU(dest, src)
+    IMPLICIT NONE
+    TYPE(dftU_type), INTENT(INOUT) :: dest
+    TYPE(dftU_type), INTENT(IN)    :: src
+    !
+    dest%tagname = src%tagname
+    dest%lwrite  = src%lwrite
+    dest%lread   = src%lread
+    dest%new_format_ispresent = src%new_format_ispresent
+    IF (src%new_format_ispresent) dest%new_format = src%new_format
+    dest%lda_plus_u_kind_ispresent = src%lda_plus_u_kind_ispresent
+    IF (src%lda_plus_u_kind_ispresent) dest%lda_plus_u_kind = src%lda_plus_u_kind
+    dest%U_projection_type_ispresent = src%U_projection_type_ispresent
+    IF (src%U_projection_type_ispresent) dest%U_projection_type = src%U_projection_type
+    !
+    CALL copy_HubbardOcc_array(dest%Hubbard_Occ, dest%Hubbard_Occ_ispresent, dest%ndim_Hubbard_Occ, &
+                                src%Hubbard_Occ, src%Hubbard_Occ_ispresent, src%ndim_Hubbard_Occ)
+    CALL copy_HubbardCommon_array(dest%Hubbard_U, dest%Hubbard_U_ispresent, dest%ndim_Hubbard_U, &
+                                src%Hubbard_U, src%Hubbard_U_ispresent, src%ndim_Hubbard_U)
+    CALL copy_HubbardM_array(dest%Hubbard_Um, dest%Hubbard_Um_ispresent, dest%ndim_Hubbard_Um, &
+                                src%Hubbard_Um, src%Hubbard_Um_ispresent, src%ndim_Hubbard_Um)
+    CALL copy_HubbardCommon_array(dest%Hubbard_J0, dest%Hubbard_J0_ispresent, dest%ndim_Hubbard_J0, &
+                                src%Hubbard_J0, src%Hubbard_J0_ispresent, src%ndim_Hubbard_J0)
+    CALL copy_HubbardCommon_array(dest%Hubbard_alpha, dest%Hubbard_alpha_ispresent, dest%ndim_Hubbard_alpha, &
+                                src%Hubbard_alpha, src%Hubbard_alpha_ispresent, src%ndim_Hubbard_alpha)
+    CALL copy_HubbardCommon_array(dest%Hubbard_beta, dest%Hubbard_beta_ispresent, dest%ndim_Hubbard_beta, &
+                                src%Hubbard_beta, src%Hubbard_beta_ispresent, src%ndim_Hubbard_beta)
+    CALL copy_HubbardJ_array(dest%Hubbard_J, dest%Hubbard_J_ispresent, dest%ndim_Hubbard_J, &
+                                src%Hubbard_J, src%Hubbard_J_ispresent, src%ndim_Hubbard_J)
+    CALL copy_starting_ns_array(dest%starting_ns, dest%starting_ns_ispresent, dest%ndim_starting_ns, &
+                                src%starting_ns, src%starting_ns_ispresent, src%ndim_starting_ns)
+    CALL copy_HubbardInterSpecieV_array(dest%Hubbard_V, dest%Hubbard_V_ispresent, dest%ndim_Hubbard_V, &
+                                src%Hubbard_V, src%Hubbard_V_ispresent, src%ndim_Hubbard_V)
+    CALL copy_Hubbard_ns_array(dest%Hubbard_ns, dest%Hubbard_ns_ispresent, dest%ndim_Hubbard_ns, &
+                                src%Hubbard_ns, src%Hubbard_ns_ispresent, src%ndim_Hubbard_ns)
+    CALL copy_orderUm_array(dest%Hub_m_order, dest%Hub_m_order_ispresent, dest%ndim_Hub_m_order, &
+                                src%Hub_m_order, src%Hub_m_order_ispresent, src%ndim_Hub_m_order)
+    CALL copy_HubbardBack_array(dest%Hubbard_back, dest%Hubbard_back_ispresent, dest%ndim_Hubbard_back, &
+                                src%Hubbard_back, src%Hubbard_back_ispresent, src%ndim_Hubbard_back)
+    CALL copy_HubbardCommon_array(dest%Hubbard_alpha_back, dest%Hubbard_alpha_back_ispresent, dest%ndim_Hubbard_alpha_back, &
+                                src%Hubbard_alpha_back, src%Hubbard_alpha_back_ispresent, src%ndim_Hubbard_alpha_back)
+    CALL copy_Hubbard_ns_array(dest%Hubbard_ns_nc, dest%Hubbard_ns_nc_ispresent, dest%ndim_Hubbard_ns_nc, &
+                                src%Hubbard_ns_nc, src%Hubbard_ns_nc_ispresent, src%ndim_Hubbard_ns_nc)
+    !
+  END SUBROUTINE qes_safe_copy_dftU

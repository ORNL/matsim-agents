+  SUBROUTINE qes_safe_copy_vdW(dest, src)
+    IMPLICIT NONE
+    TYPE(vdW_type), INTENT(INOUT) :: dest
+    TYPE(vdW_type), INTENT(IN)    :: src
+    !
+    dest%tagname = src%tagname
+    dest%lwrite  = src%lwrite
+    dest%lread   = src%lread
+    dest%vdw_corr_ispresent = src%vdw_corr_ispresent
+    IF (src%vdw_corr_ispresent) dest%vdw_corr = src%vdw_corr
+    dest%dftd3_version_ispresent = src%dftd3_version_ispresent
+    IF (src%dftd3_version_ispresent) dest%dftd3_version = src%dftd3_version
+    dest%dftd3_threebody_ispresent = src%dftd3_threebody_ispresent
+    IF (src%dftd3_threebody_ispresent) dest%dftd3_threebody = src%dftd3_threebody
+    dest%non_local_term_ispresent = src%non_local_term_ispresent
+    IF (src%non_local_term_ispresent) dest%non_local_term = src%non_local_term
+    dest%functional_ispresent = src%functional_ispresent
+    IF (src%functional_ispresent) dest%functional = src%functional
+    dest%total_energy_term_ispresent = src%total_energy_term_ispresent
+    IF (src%total_energy_term_ispresent) dest%total_energy_term = src%total_energy_term
+    dest%london_s6_ispresent = src%london_s6_ispresent
+    IF (src%london_s6_ispresent) dest%london_s6 = src%london_s6
+    dest%ts_vdw_econv_thr_ispresent = src%ts_vdw_econv_thr_ispresent
+    IF (src%ts_vdw_econv_thr_ispresent) dest%ts_vdw_econv_thr = src%ts_vdw_econv_thr
+    dest%ts_vdw_isolated_ispresent = src%ts_vdw_isolated_ispresent
+    IF (src%ts_vdw_isolated_ispresent) dest%ts_vdw_isolated = src%ts_vdw_isolated
+    dest%london_rcut_ispresent = src%london_rcut_ispresent
+    IF (src%london_rcut_ispresent) dest%london_rcut = src%london_rcut
+    dest%xdm_a1_ispresent = src%xdm_a1_ispresent
+    IF (src%xdm_a1_ispresent) dest%xdm_a1 = src%xdm_a1
+    dest%xdm_a2_ispresent = src%xdm_a2_ispresent
+    IF (src%xdm_a2_ispresent) dest%xdm_a2 = src%xdm_a2
+    !
+    CALL copy_HubbardCommon_array(dest%london_c6, dest%london_c6_ispresent, dest%ndim_london_c6, &
+                                src%london_c6, src%london_c6_ispresent, src%ndim_london_c6)
+    !
+  END SUBROUTINE qes_safe_copy_vdW
+  !
+  ! ---- manual, descriptor-safe array-of-derived-type copy helpers ----------
+  ! Each helper: deallocate dest if allocated, copy the ispresent/ndim flags,
+  ! and if src is present/allocated, ALLOCATE dest to match and copy every
+  ! field one at a time (recursing the same pattern for any nested
+  ! ALLOCATABLE component). No compiler-synthesized structure copy is used
+  ! anywhere below.
+  !
+  SUBROUTINE copy_HubbardCommon_array(dest, dest_ispresent, dest_ndim, src, src_ispresent, src_ndim)
+    IMPLICIT NONE
+    TYPE(HubbardCommon_type), DIMENSION(:), ALLOCATABLE, INTENT(INOUT) :: dest
+    LOGICAL, INTENT(INOUT) :: dest_ispresent
+    INTEGER, INTENT(INOUT) :: dest_ndim
+    TYPE(HubbardCommon_type), DIMENSION(:), ALLOCATABLE, INTENT(IN) :: src
+    LOGICAL, INTENT(IN) :: src_ispresent
+    INTEGER, INTENT(IN) :: src_ndim
+    INTEGER :: i, n
+    !
+    IF (ALLOCATED(dest)) DEALLOCATE(dest)
+    dest_ispresent = src_ispresent
+    dest_ndim = src_ndim
+    IF (src_ispresent .AND. ALLOCATED(src)) THEN
+      n = SIZE(src)
+      ALLOCATE(dest(n))
+      DO i = 1, n
+        dest(i)%tagname = src(i)%tagname
+        dest(i)%lwrite  = src(i)%lwrite
+        dest(i)%lread   = src(i)%lread
+        dest(i)%specie  = src(i)%specie
+        dest(i)%specie_ispresent = src(i)%specie_ispresent
+        dest(i)%label   = src(i)%label
+        dest(i)%label_ispresent = src(i)%label_ispresent
+        dest(i)%HubbardCommon = src(i)%HubbardCommon
+      END DO
+    END IF
+  END SUBROUTINE copy_HubbardCommon_array
+  !

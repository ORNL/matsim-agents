+  SUBROUTINE copy_HubbardOcc_array(dest, dest_ispresent, dest_ndim, src, src_ispresent, src_ndim)
+    IMPLICIT NONE
+    TYPE(HubbardOcc_type), DIMENSION(:), ALLOCATABLE, INTENT(INOUT) :: dest
+    LOGICAL, INTENT(INOUT) :: dest_ispresent
+    INTEGER, INTENT(INOUT) :: dest_ndim
+    TYPE(HubbardOcc_type), DIMENSION(:), ALLOCATABLE, INTENT(IN) :: src
+    LOGICAL, INTENT(IN) :: src_ispresent
+    INTEGER, INTENT(IN) :: src_ndim
+    INTEGER :: i, j, n, m
+    !
+    IF (ALLOCATED(dest)) DEALLOCATE(dest)
+    dest_ispresent = src_ispresent
+    dest_ndim = src_ndim
+    IF (src_ispresent .AND. ALLOCATED(src)) THEN
+      n = SIZE(src)
+      ALLOCATE(dest(n))
+      DO i = 1, n
+        dest(i)%tagname  = src(i)%tagname
+        dest(i)%lwrite   = src(i)%lwrite
+        dest(i)%lread    = src(i)%lread
+        dest(i)%channels = src(i)%channels
+        dest(i)%specie   = src(i)%specie
+        dest(i)%ndim_channel_occ = src(i)%ndim_channel_occ
+        IF (ALLOCATED(src(i)%channel_occ)) THEN
+          m = SIZE(src(i)%channel_occ)
+          ALLOCATE(dest(i)%channel_occ(m))
+          DO j = 1, m
+            dest(i)%channel_occ(j)%tagname = src(i)%channel_occ(j)%tagname
+            dest(i)%channel_occ(j)%lwrite  = src(i)%channel_occ(j)%lwrite
+            dest(i)%channel_occ(j)%lread   = src(i)%channel_occ(j)%lread
+            dest(i)%channel_occ(j)%specie  = src(i)%channel_occ(j)%specie
+            dest(i)%channel_occ(j)%specie_ispresent = src(i)%channel_occ(j)%specie_ispresent
+            dest(i)%channel_occ(j)%label   = src(i)%channel_occ(j)%label
+            dest(i)%channel_occ(j)%label_ispresent = src(i)%channel_occ(j)%label_ispresent
+            dest(i)%channel_occ(j)%index   = src(i)%channel_occ(j)%index
+            dest(i)%channel_occ(j)%ChannelOcc = src(i)%channel_occ(j)%ChannelOcc
+          END DO
+        END IF
+      END DO
+    END IF
+  END SUBROUTINE copy_HubbardOcc_array

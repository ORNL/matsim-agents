+  SUBROUTINE buiol_copy_z(n, dst, src)
+    !! Explicit-shape OpenMP copy. Cray ftn (cce 18-20) miscompiles an array
+    !! assignment to a pointer component of a derived type inside an OpenMP
+    !! WORKSHARE (orphaned or PARALLEL WORKSHARE) and segfaults in pw.x.
+    IMPLICIT NONE
+    INTEGER,INTENT(in) :: n
+    COMPLEX(dp),INTENT(out) :: dst(n)
+    COMPLEX(dp),INTENT(in) :: src(n)
+    INTEGER :: i
+    !$omp parallel do
+    DO i = 1, n
+       dst(i) = src(i)
+    END DO
+    !$omp end parallel do
+  END SUBROUTINE buiol_copy_z
+  ! \/o\________\\\_________________________________________/^>

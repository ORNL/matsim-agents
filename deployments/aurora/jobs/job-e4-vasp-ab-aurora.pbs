#!/bin/bash
#PBS -N e4-vasp-ab
#PBS -A HydraGNN
#PBS -q capacity
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=08:00:00
#PBS -l filesystems=home:flare
#PBS -k doe
#PBS -j oe
# E4 VASP binary A/B pilot: one workflow (Low then Normal relaxation) for one
# binary and one repetition. Submit with:
#   qsub -v REPO=<repo>,CASE_DIR=<.../case-1>,VARIANT=custom|alcf,REPEAT=repeat-NN
# Add E4_RESUME=1 to resume a repetition created with this checkpoint policy.
set -euo pipefail

: "${REPO:?}" "${CASE_DIR:?}" "${VARIANT:?}" "${REPEAT:?}"
[[ "${REPEAT}" =~ ^repeat-[0-9]{2}$ ]] || { echo "bad REPEAT=${REPEAT}" >&2; exit 2; }
case "${VARIANT}" in
  custom) VASP_BIN="${REPO}/external/vasp6/src/vasp.6.6.1/bin/vasp_std"
          VASP_SHA256=ebd284027717ff564abf7ceaf93c3aca3261b129d7b60b3f2e3e2aa82d04c552 ;;
  alcf)   VASP_BIN=/soft/applications/vasp/vasp.6.6.1/bin/vasp_std
          VASP_SHA256=3354871ac0b7a812ebe3444dbd3d5bb4176995a5c37c3859978b58b5c7b55eb6 ;;
  *) echo "bad VARIANT=${VARIANT}" >&2; exit 2 ;;
esac
MPICH_MODULE=mpich/prd/5.0.0.aurora_test.51a9474
RANKS=8
THREADS=8
NSW_MAX="${E4_NSW:-30}"
CHECKPOINT_SECONDS="${E4_CHECKPOINT_SECONDS:-3600}"
RESUME="${E4_RESUME:-0}"
[[ "${RESUME}" == 0 || "${RESUME}" == 1 ]] || { echo "bad E4_RESUME=${RESUME}" >&2; exit 2; }
[[ "${CHECKPOINT_SECONDS}" =~ ^[1-9][0-9]*$ ]] || {
  echo "E4_CHECKPOINT_SECONDS must be a positive integer" >&2; exit 2;
}
SOFT_STOP_SECONDS="${E4_SOFT_STOP_SECONDS:-27000}"
JOB_START=$(date +%s)
[[ "${NSW_MAX}" =~ ^[1-9][0-9]*$ ]] || { echo "bad E4_NSW=${NSW_MAX}" >&2; exit 2; }
[[ "${SOFT_STOP_SECONDS}" =~ ^[1-9][0-9]*$ ]] &&
  [[ "${SOFT_STOP_SECONDS}" -lt 28800 ]] || {
    echo "E4_SOFT_STOP_SECONDS must be a positive integer below the 8-hour walltime" >&2
    exit 2
  }
SOFT_STOP_DEADLINE=$((JOB_START + SOFT_STOP_SECONDS))
NELM_MAX=170
VASP_STEP="${VASP_STEP:-${REPO}/deployments/aurora/launchers/_vasp-step-aurora.sh}"

umask 077
ROOT="${CASE_DIR}/${VARIANT}/${REPEAT}"
mkdir -p "${CASE_DIR}/${VARIANT}"
if [[ "${RESUME}" == 0 ]]; then
  mkdir "${ROOT}"
  mkdir "${ROOT}/attempts"
else
  [[ -d "${ROOT}/attempts" ]] || { echo "No repetition to resume: ${ROOT}" >&2; exit 2; }
fi
command -v flock >/dev/null || { echo "flock is required for repetition locking" >&2; exit 2; }
exec 9>"${ROOT}/.allocation.lock"
flock -n 9 || { echo "Repetition is already active: ${ROOT}" >&2; exit 2; }
mkdir -p "${ROOT}/allocations"
ALLOCATION_DIR=$(mktemp -d "${ROOT}/allocations/allocation-XXXXXX")
RECORD="${ROOT}/run-record.log"
log() { echo "[e4-ab $(date -Is)] $*" | tee -a "${RECORD}"; }
WATCHDOG_PID=""
ACTIVE_RUN_DIR=""
STOP_MARKER="${ALLOCATION_DIR}/soft-stop-requested"
stop_watchdog() {
  if [[ -n "${WATCHDOG_PID}" ]]; then
    kill "${WATCHDOG_PID}" 2>/dev/null || true
    wait "${WATCHDOG_PID}" 2>/dev/null || true
    WATCHDOG_PID=""
  fi
}
cleanup() {
  local rc=$?
  stop_watchdog
  log "EXIT status=${rc} final=${FINAL:-incomplete}"
}
request_stop() {
  printf '%s\n' "$1" > "${STOP_MARKER}"
  if [[ -n "${ACTIVE_RUN_DIR}" ]]; then
    printf 'LSTOP = .TRUE.\n' > "${ACTIVE_RUN_DIR}/STOPCAR"
  fi
  log "stop requested reason=$1 dir=${ACTIVE_RUN_DIR:-none}"
}
trap cleanup EXIT
trap 'request_stop scheduler-signal-TERM' TERM
trap 'request_stop scheduler-signal-USR1' USR1

log "job=${PBS_JOBID:-none} host=$(hostname) variant=${VARIANT} repeat=${REPEAT} root=${ROOT}"
log "checkpoint_nsw=${NSW_MAX} checkpoint_seconds=${CHECKPOINT_SECONDS} soft_stop_seconds=${SOFT_STOP_SECONDS} resume=${RESUME} allocation=${ALLOCATION_DIR}"
(cd "${CASE_DIR}" && sha256sum -c inputs.sha256) | tee -a "${RECORD}"
echo "${VASP_SHA256}  ${VASP_BIN}" | sha256sum -c - | tee -a "${RECORD}"

if ! command -v module >/dev/null 2>&1; then
  for init in /etc/profile.d/modules.sh /usr/share/lmod/lmod/init/bash; do
    # shellcheck disable=SC1090
    [[ -f "${init}" ]] && { source "${init}"; break; }
  done
fi
# shellcheck disable=SC1091
export VASP_ENV_SETUP="${VASP_ENV_SETUP:-${REPO}/deployments/aurora/setup/vasp-runtime-aurora.sh}"
export VASP_MPICH_MODULE="${MPICH_MODULE}"
export VASP_EXPECTED_SHA256="${VASP_SHA256}"
# shellcheck disable=SC1091
source "${REPO}/deployments/common/vasp-runtime.sh"
MODULES="$(module -t list 2>&1)"
echo "${MODULES}" >> "${RECORD}"
grep -qx "${MPICH_MODULE}" <<<"${MODULES}"
LDD="$(ldd "${VASP_BIN}")"
echo "${LDD}" >> "${RECORD}"
if grep -q "not found" <<<"${LDD}"; then echo "missing libraries" >&2; exit 1; fi
env | sort > "${ALLOCATION_DIR}/environment.txt"

export MATSIM_ASSIGNED_NODES="${MATSIM_ASSIGNED_NODES:-$(head -n1 "${PBS_NODEFILE:-/dev/null}" 2>/dev/null || hostname)}"
ATTEMPT=0
STATUS=""

initialize_recovery() {
  local identity saved tag prec status digest extra path number
  identity=$(
    {
      printf '%s\n' "$(realpath "${CASE_DIR}")" "${VARIANT}" "${REPEAT}" \
        "${VASP_SHA256}" "${NSW_MAX}" "${CHECKPOINT_SECONDS}"
      (cd "${CASE_DIR}" && sha256sum START POSCAR KPOINTS POTCAR)
      sha256sum "${VASP_ENV_SETUP}"
    } | sha256sum | awk '{print $1}'
  )
  if [[ "${RESUME}" == 0 ]]; then
    printf '%s\n' "${identity}" > "${ROOT}/protocol.sha256"
    RESUME_TAG=-
    RESUME_PREC=Low
    RESUME_STATUS=fresh
    return
  fi
  [[ -s "${ROOT}/protocol.sha256" && -s "${ROOT}/latest-checkpoint" ]] || {
    log "resume rejected: no trusted checkpoint metadata (legacy runs require separate validation)"
    exit 2
  }
  saved=$(cat "${ROOT}/protocol.sha256")
  [[ "${identity}" == "${saved}" ]] || {
    log "resume rejected: case, inputs, binary or checkpoint policy changed"; exit 2;
  }
  read -r tag prec status digest extra < "${ROOT}/latest-checkpoint"
  [[ "${tag}" =~ ^N?[0-9]+$ && -z "${extra}" &&
     "${digest}" =~ ^[0-9a-f]{64}$ ]] || { log "invalid checkpoint metadata"; exit 2; }
  case "${prec}:${tag}" in
    Low:[0-9]*|Normal:N[0-9]*) ;;
    *) log "invalid checkpoint precision"; exit 2 ;;
  esac
  case "${status}" in
    converged|nsw-exhausted|checkpoint:time|interrupted:stopcar) ;;
    *) log "invalid checkpoint status"; exit 2 ;;
  esac
  [[ -s "${ROOT}/${tag}.checkpoint.sha256" ]] || { log "missing checkpoint manifest"; exit 2; }
  [[ "$(sha256sum "${ROOT}/${tag}.checkpoint.sha256" | awk '{print $1}')" == "${digest}" ]] || {
    log "checkpoint manifest hash mismatch"; exit 2;
  }
  # Verify an exact, locally generated file set rather than trusting paths in a manifest.
  (cd "${ROOT}" && sha256sum "${tag}.INCAR" "${tag}.OUTCAR" "${tag}.OSZICAR" \
    "${tag}.CONTCAR" "${tag}.WAVECAR" "${tag}.CHGCAR") > "${ALLOCATION_DIR}/verified.sha256"
  cmp -s "${ALLOCATION_DIR}/verified.sha256" "${ROOT}/${tag}.checkpoint.sha256" || {
    log "checkpoint file hash mismatch"; exit 2;
  }
  RESUME_TAG="${tag}"
  RESUME_PREC="${prec}"
  RESUME_STATUS="${status}"
  for path in "${ROOT}"/attempts/attempt-*; do
    [[ -d "${path}" ]] || continue
    number="${path##*/attempt-}"
    [[ "${number}" =~ ^[0-9]+$ ]] || { log "invalid attempt directory ${path}"; exit 2; }
    number=$((10#${number}))
    (( number <= ATTEMPT )) || ATTEMPT=${number}
  done
  log "resume verified tag=${tag} prec=${prec} status=${status}"
}

next_tag_number() {
  local prefix=$1 path tag number max=-1
  for path in "${ROOT}"/attempts/attempt-*/snapshot-tag; do
    [[ -f "${path}" ]] || continue
    read -r tag < "${path}"
    [[ "${tag}" =~ ^N?[0-9]+$ ]] || { log "invalid snapshot tag ${path}" >&2; return 2; }
    [[ "${tag}" == "${prefix}"[0-9]* ]] || continue
    number="${tag#${prefix}}"
    number=$((10#${number}))
    (( number <= max )) || max=${number}
  done
  printf '%s\n' "$((max + 1))"
}

# run_vasp <tag> <PREC> <src-tag|-> ; "-" = fresh start from the case POSCAR.
run_vasp() {
  local tag=$1 prec=$2 src=$3 w out err rc t0 t1 nion launcher_pid remaining f
  if [[ -e "${STOP_MARKER}" ]] || (( $(date +%s) >= SOFT_STOP_DEADLINE )); then
    STATUS=interrupted:soft-stop-before-launch
    log "skip tag=${tag} status=${STATUS}"
    return
  fi
  ATTEMPT=$((ATTEMPT + 1))
  w="${ROOT}/attempts/attempt-$(printf %02d "${ATTEMPT}")"
  mkdir "${w}"
  printf '%s\n' "${tag}" > "${w}/snapshot-tag"
  cp "${CASE_DIR}/KPOINTS" "${CASE_DIR}/POTCAR" "${w}/"
  if [[ "${src}" == - ]]; then
    cp "${CASE_DIR}/POSCAR" "${w}/POSCAR"
    sed "s/PRECISION/${prec}/" "${CASE_DIR}/START" > "${w}/INCAR"
    grep -qE '^ISTART *= *0' "${w}/INCAR"
    grep -qE '^ICHARG *= *2' "${w}/INCAR"
  else
    for f in CONTCAR WAVECAR CHGCAR; do
      [[ -s "${ROOT}/${src}.${f}" ]] || {
        log "invalid restart: missing or empty ${src}.${f}"
        STATUS=failed:invalid-checkpoint
        return
      }
    done
    cp "${ROOT}/${src}.CONTCAR" "${w}/POSCAR"
    # Copies, not links: VASP rewrites WAVECAR/CHGCAR in place.
    cp "${ROOT}/${src}.WAVECAR" "${w}/WAVECAR"
    cp "${ROOT}/${src}.CHGCAR" "${w}/CHGCAR"
    sed -e "s/PRECISION/${prec}/" -e 's/^ISTART *=.*/ISTART = 1/' \
        -e 's/^ICHARG *=.*/ICHARG = 1/' "${CASE_DIR}/START" > "${w}/INCAR"
    grep -qE '^ISTART = 1$' "${w}/INCAR"
    grep -qE '^ICHARG = 1$' "${w}/INCAR"
  fi
  # Replace output/segment tags, including semicolon-separated assignments.
  awk '
    {
      line = $0
      comment = ""
      if (match(line, /[#!]/)) {
        comment = substr(line, RSTART)
        line = substr(line, 1, RSTART - 1)
      }
      n = split(line, fields, ";")
      for (i = 1; i <= n; i++)
        if (toupper(fields[i]) !~ /^[[:space:]]*(NSW|LWAVE|LCHARG|LH5)[[:space:]]*=/)
          print fields[i]
      if (comment != "") print comment
    }
  ' "${w}/INCAR" > "${w}/INCAR.checkpoint"
  printf 'NSW = %s\nLWAVE = .TRUE.\nLCHARG = .TRUE.\nLH5 = .FALSE.\n' \
    "${NSW_MAX}" >> "${w}/INCAR.checkpoint"
  mv "${w}/INCAR.checkpoint" "${w}/INCAR"
  grep -qE "^PREC *= *${prec}\$" "${w}/INCAR"
  grep -qE '^KPAR *= *8$' "${w}/INCAR"
  case "${tag}" in
    N0) out=rlx1.out; err=rlx2.out ;;
    *)  out="rlx1.${tag}.out"; err="rlx2.${tag}.out" ;;
  esac
  log "start tag=${tag} prec=${prec} from=${src} dir=${w}"
  t0=$(date +%s)
  ACTIVE_RUN_DIR="${w}"
  remaining=$((SOFT_STOP_DEADLINE - t0))
  if (( remaining <= 0 )) || [[ -e "${STOP_MARKER}" ]]; then
    ACTIVE_RUN_DIR=""
    STATUS=interrupted:soft-stop-before-launch
    log "skip tag=${tag} status=${STATUS}"
    return
  fi
  (
    segment_wait=${CHECKPOINT_SECONDS}
    stop_reason=checkpoint-interval
    if (( remaining <= segment_wait )); then
      segment_wait=${remaining}
      stop_reason=soft-walltime-limit
    fi
    sleep "${segment_wait}" &
    sleeper_pid=$!
    trap 'kill "${sleeper_pid}" 2>/dev/null || true; wait "${sleeper_pid}" 2>/dev/null || true' EXIT
    trap 'exit 0' TERM
    wait "${sleeper_pid}"
    if [[ "${stop_reason}" == soft-walltime-limit ]]; then
      request_stop "${stop_reason}"
    else
      printf 'checkpoint-interval\n' > "${w}/stop-reason"
      printf 'LSTOP = .TRUE.\n' > "${w}/STOPCAR"
      log "segment checkpoint requested tag=${tag}"
    fi
  ) &
  WATCHDOG_PID=$!
  set +e
  bash "${VASP_STEP}" "${w}" "${VASP_BIN}" 1 "${RANKS}" "${THREADS}" > "${w}/${out}" 2> "${w}/${err}" &
  launcher_pid=$!
  # A trapped scheduler signal interrupts wait, but must not abandon VASP.
  while true; do
    wait "${launcher_pid}"
    rc=$?
    kill -0 "${launcher_pid}" 2>/dev/null || break
  done
  set -e
  stop_watchdog
  ACTIVE_RUN_DIR=""
  t1=$(date +%s)
  for f in INCAR POSCAR CONTCAR OUTCAR XDATCAR OSZICAR WAVECAR CHGCAR STOPCAR stop-reason; do
    if [[ -e "${w}/${f}" ]]; then ln "${w}/${f}" "${ROOT}/${tag}.${f}"; fi
  done
  ln "${w}/${out}" "${ROOT}/${out}"
  ln "${w}/${err}" "${ROOT}/${err}"
  nion=$(grep -c 'F=' "${w}/OSZICAR" 2>/dev/null || true)
  if [[ ${rc} -ne 0 ]]; then
    STATUS=failed:exit-${rc}
  elif ! grep -q 'General timing and accounting' "${w}/OUTCAR" 2>/dev/null; then
    STATUS=failed:abnormal-termination
  elif ! awk -v m="${NELM_MAX}" '/^(DAV|RMM|CG|DIA):/{s=$2} /F=/{if (s >= m) bad=1; s=0} END{exit bad}' "${w}/OSZICAR"; then
    STATUS=failed:electronic-nonconvergence
  elif [[ ! -s "${w}/CONTCAR" || ! -s "${w}/WAVECAR" || ! -s "${w}/CHGCAR" ]]; then
    STATUS=failed:invalid-checkpoint
  elif (( nion < 1 )); then
    STATUS=failed:no-completed-ionic-step
  elif grep -q 'reached required accuracy' "${w}/OUTCAR"; then
    STATUS=converged
  elif [[ -e "${w}/STOPCAR" ]]; then
    if [[ ! -e "${STOP_MARKER}" && -s "${w}/stop-reason" ]] &&
       [[ "$(cat "${w}/stop-reason")" == checkpoint-interval ]]; then
      STATUS=checkpoint:time
    else
      STATUS=interrupted:stopcar
    fi
  elif [[ "${nion}" -eq "${NSW_MAX}" ]]; then
    STATUS=nsw-exhausted
  else
    STATUS=failed:unrecognized-stop
  fi
  case "${STATUS}" in
    converged|nsw-exhausted|checkpoint:time|interrupted:stopcar)
      (cd "${ROOT}" && sha256sum "${tag}.INCAR" "${tag}.OUTCAR" "${tag}.OSZICAR" \
        "${tag}.CONTCAR" "${tag}.WAVECAR" "${tag}.CHGCAR") \
        > "${ROOT}/${tag}.checkpoint.sha256"
      printf '%s %s %s %s\n' "${tag}" "${prec}" "${STATUS}" \
        "$(sha256sum "${ROOT}/${tag}.checkpoint.sha256" | awk '{print $1}')" \
        > "${ALLOCATION_DIR}/latest-checkpoint.tmp"
      mv "${ALLOCATION_DIR}/latest-checkpoint.tmp" "${ROOT}/latest-checkpoint"
      log "checkpoint tag=${tag} prec=${prec} manifest=${ROOT}/${tag}.checkpoint.sha256"
      ;;
  esac
  log "end tag=${tag} rc=${rc} ionic_steps=${nion} seconds=$((t1 - t0)) status=${STATUS}"
}

# run_stage <PREC> <tag-prefix> <seed-tag|->
run_stage() {
  local prec=$1 pfx=$2 src=$3 k
  k=$(next_tag_number "${pfx}")
  run_vasp "${pfx}${k}" "${prec}" "${src}"
  while [[ "${STATUS}" == nsw-exhausted || "${STATUS}" == checkpoint:time ]]; do
    k=$((k + 1))
    run_vasp "${pfx}${k}" "${prec}" "${pfx}$((k - 1))"
  done
  if [[ "${STATUS}" != converged ]]; then
    FINAL="${prec}:${STATUS}"
    case "${STATUS}" in
      interrupted:*) exit 75 ;;
      *) exit 1 ;;
    esac
  fi
  LAST_TAG="${pfx}${k}"
}

initialize_recovery
if [[ "${RESUME_PREC}" == Normal ]]; then
  if [[ "${RESUME_STATUS}" == converged ]]; then
    FINAL="converged:${RESUME_TAG}"
    log "already complete tag=${RESUME_TAG}; no launch"
    exit 0
  fi
  run_stage Normal N "${RESUME_TAG}"
else
  if [[ "${RESUME_STATUS}" == converged ]]; then
    LAST_TAG="${RESUME_TAG}"
  else
    run_stage Low "" "${RESUME_TAG}"
  fi
  run_stage Normal N "${LAST_TAG}"
fi
FINAL="converged:${LAST_TAG}"

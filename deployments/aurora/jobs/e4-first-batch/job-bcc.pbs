#!/bin/bash
#PBS -N e4-bcc
#PBS -A HydraGNN
#PBS -q capacity
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=24:00:00
#PBS -l filesystems=home:flare
#PBS -k doe
#PBS -j oe
set -euo pipefail

: "${E4_CASE_DIR:?}" "${E4_CALCULATION_ID:?}"
readonly REPO=/lus/flare/projects/HydraGNN/mlupopa/AgenticAI4Materials/matsim-agents-e3-e4
export REPO CASE_DIR="${E4_CASE_DIR}" VARIANT=alcf REPEAT=repeat-01
export E4_CALCULATION_ID E4_STAGE_MODE=low-normal E4_STAGE_NSW_MAX=240
export E4_MPI_RANKS=8 E4_OMP_THREADS=8
export E4_EDIFFG=-0.01 E4_REQUESTED_NODES=1 E4_REQUESTED_WALLTIME_SECONDS=86400
export E4_SOFT_STOP_SECONDS=82800 E4_CHECKPOINT_SECONDS=3600
exec bash "${REPO}/deployments/aurora/jobs/job-e4-vasp-ab-aurora.pbs"

# Codabench scoring program manifest.
# Codabench mounts the submission at $input/res and the reference data at
# $input/ref, and expects scores written to $output/scores.json.
# score.py reads <input_dir> (= $input, containing res/ and ref/) and
# <output_dir> (= $output).
command: python3 $program/score.py $input $output
description: >-
  Scores the Matsim-Agents multi-task materials-ML submission (formation
  energy, forces, relaxation RMSD, AI-accelerated DFT, phase-stability
  ranking) and emits public_/private_ metrics plus an advisory DFT-cheating
  flag. Requires numpy and scipy in the execution image.

&CONTROL
  calculation   = 'relax'
  prefix        = 'pwscf'
  pseudo_dir    = 'PSEUDO_DIR'
  outdir        = './tmp'
  tprnfor       = .true.
  tstress       = .true.
  verbosity     = 'high'
  etot_conv_thr = 1.00000000d-04
  forc_conv_thr = 1.00000000d-03
  nstep         = 100
/
&SYSTEM
  ibrav       = 0
  nat         = 2
  ntyp        = 1
  ecutwfc     = 2.00000000d+01
  ecutrho     = 1.60000000d+02
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr         = 1.00000000d-08
  mixing_beta      = 4.00000000d-01
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  Si  28.0850  Si_r.upf

CELL_PARAMETERS angstrom
        0.0000000000       2.7500000000       2.7500000000
        2.7500000000       0.0000000000       2.7500000000
        2.7500000000       2.7500000000       0.0000000000

ATOMIC_POSITIONS angstrom
  Si        0.0000000000       0.0000000000       0.0000000000
  Si        1.4250000000       1.3450000000       1.3950000000

K_POINTS automatic
  2 2 2  0 0 0

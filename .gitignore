# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
perlmutter_venv/
scripts/perlmutter_venv/
.env
.envrc

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Atomistic / ML artifacts — binaries tracked via Git LFS (see .gitattributes)
*.traj
*.vasp
*.cif
*.xyz
*_optimization.csv
multidataset_hpo-*/

# ...but keep the bundled test fixtures.
!tests/integration/data/*.vasp
!tests/integration/data/*.cif
!tests/integration/data/*.xyz
mlp_branch_weights.pt
runs/
outputs/
logs/
test_matsim_perlmutter.out

# External code built/installed via scripts/setup/* (e.g. quantum-espresso).
# Repo "owns" the path layout via the build scripts, but artifacts (source
# clones, build trees, install prefixes) are too large for git.
external/

# Explicit proprietary VASP inputs used for Aurora builds.
external/vasp6/src/vasp.6.6.0/
external/vasp6/src/vasp.6.6.0.tgz

# VASP POTCAR pseudopotential library (licensed by VASP, NOT redistributable).
# Layout: external/vasp6/potcar/<set>/<Element>/POTCAR
# Point MATSIM_VASP_POTCAR_DIR at a concrete <set> (e.g. potpaw_PBE.64).
external/vasp6/potcar/

# VASP calculation outputs — never commit these anywhere in the tree.
# POTCAR: licensed, illegal to redistribute.
# WAVECAR / CHGCAR / CHG: binary restart files, typically gigabytes.
**/POTCAR
**/WAVECAR
**/WAVECAR.gz
**/PROCAR
**/DOSCAR
**/EIGENVAL
**/IBZKPT
**/REPORT
# DFT result files — contain ground-truth energies/forces (competition labels).
# These must remain server-side only; committing them would let participants cheat.
**/OUTCAR
**/CONTCAR
**/CHGCAR
**/CHG
**/vasprun.xml
# Structure anonymisation mapping — MUST stay in the private repo only.
# If this file ever appears here it means someone accidentally copied it from
# matsim-agents-dft-reference/; block it to prevent accidental exposure.
matsim-agents-dft-reference/
id_mapping.json
**/id_mapping.json

# Codabench reference data labels — server-side only, never publish
codabench_competition/reference_data/formation_energies.csv
codabench_competition/reference_data/forces/
codabench_competition/reference_data/relaxed/
codabench_competition/reference_data/task4_relaxed/
# Parsed elemental energies (derived from VASP OUTCARs — also sensitive)
codabench_competition/dft_reference/vasp/elemental_refs/elemental_energies.json
# VASP compound and elemental calculation output trees (contain OUTCARs)
codabench_competition/dft_reference/vasp/compounds/
# VASP elemental reference calculation inputs — reproducible from setup_elements.py
# but committing them would trivially expose the exact DFT settings needed to
# reproduce the reference energies (POSCAR + INCAR + KPOINTS → run → same result).
codabench_competition/dft_reference/vasp/elemental_refs/calculations/
# DFT input/collection scripts — moved to private repo (matsim-agents-dft-reference).
# Full recipe (INCAR params, k-spacing, POTCAR map) must not be in the public repo.
codabench_competition/dft_reference/
# Logs from PBS jobs
codabench_competition/dft_reference/vasp/elemental_refs/logs/

# Vendored third-party clones (bootstrapped by scripts/setup_env.sh)
third_party/
/HydraGNN/
/tmp/

# PBS / Slurm stdout/stderr from interactive `qsub` (`-o .`)
matsim-*.o[0-9]*
matsim-*.e[0-9]*

# PBS / Slurm stdout/stderr from any job script
*.o[0-9]*
*.e[0-9]*

&CONTROL
  calculation   = 'vc-relax'
  prefix        = 'pwscf'
  pseudo_dir    = '/global/common/software/nersc9/espresso/pseudo'
  outdir        = './tmp'
  tprnfor       = .true.
  tstress       = .true.
  verbosity     = 'high'
  etot_conv_thr = 1.00000000d-04
  forc_conv_thr = 7.77875869d-04
  nstep         = 100
/
&SYSTEM
  ibrav       = 0
  nat         = 2
  ntyp        = 2
  ecutwfc     = 45
  ecutrho     = 360
  occupations = 'smearing'
  smearing    = 'gaussian'
  degauss     = 1.00000000d-02
/
&ELECTRONS
  conv_thr         = 1.00000000d-08
  mixing_beta      = 4.00000000d-01
  electron_maxstep = 200
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  C  12.0110  C.pbe-n-kjpaw_psl.1.0.0.UPF
  Si  28.0850  Si.pbe-nl-rrkjus_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
        0.0000000000       2.1800000000       2.1800000000
        2.1800000000       0.0000000000       2.1800000000
        2.1800000000       2.1800000000       0.0000000000

ATOMIC_POSITIONS angstrom
  Si        0.0000000000       0.0000000000       0.0000000000
  C        1.0900000000       1.0900000000       1.0900000000

K_POINTS automatic
  7 7 7  0 0 0

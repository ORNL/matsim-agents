{
  "workload_id": "e4.3-heterogeneous-qe",
  "description": "E4.3 mixed workload on a fixed allocation: long one-node DFT-like steps, short device-slot tasks, and real QE/HydraGNN tasks. Run once per class with --classes (homogeneous baselines), once with all classes and --policy concurrent (the production dispatcher: node groups and device slots run at the same time), and once with --policy staged (classes run one after another) as the explicit comparison baseline.",
  "seed": 43001,
  "timeout_sec": 1800,
  "repetitions": 3,
  "task_classes": [
    {
      "name": "ctl-long-node",
      "kind": "controlled",
      "pool": "dft",
      "duration": {
        "model": "lognormal",
        "median_seconds": 120.0,
        "sigma": 0.5,
        "max_seconds": 600.0
      },
      "artifact_bytes": 1048576,
      "tasks": 48,
      "faults": {
        "fraction": 0.05,
        "attempts": 1,
        "mode": "no-result"
      }
    },
    {
      "name": "ctl-short-device",
      "kind": "controlled",
      "pool": "mlip",
      "duration": {
        "model": "uniform",
        "min_seconds": 5.0,
        "max_seconds": 20.0
      },
      "artifact_bytes": 65536,
      "tasks": 240,
      "faults": {
        "fraction": 0.05,
        "attempts": 1,
        "mode": "nonfinite"
      }
    },
    {
      "name": "qe-si-scf",
      "kind": "dft",
      "estimate_seconds": 120,
      "pool": "dft",
      "structures": [
        "benchmarks/portability/structures/Si.vasp"
      ],
      "tasks": 16
    },
    {
      "name": "hydragnn-relax",
      "kind": "mlip-relax",
      "estimate_seconds": 90,
      "pool": "mlip",
      "structures": [
        "examples/paper_cases/seeds/hea_fcc_fcc_random.extxyz",
        "examples/paper_cases/seeds/lifepo4_olivine.extxyz",
        "examples/paper_cases/seeds/phosphorene_black_P.extxyz",
        "examples/paper_cases/seeds/zn_formate_alpha_relaxed.extxyz"
      ],
      "params": {
        "mlip_backend": "hydragnn",
        "logdir": "${E4_HYDRAGNN_LOGDIR}",
        "fmax": 0.02,
        "maxiter": 200,
        "hydragnn_inference_head": "OMat24",
        "mlp_device": "${E4_MLP_DEVICE}",
        "precision": "fp64",
        "mlp_precision": "fp64"
      },
      "tasks": 24
    }
  ],
  "dft_backends": {
    "aurora": {
      "backend": "qe",
      "qe": {
        "pw_bin": "${E4_QE_PW_BIN}",
        "pw_wrapper": "deployments/aurora/launchers/_qe-step-aurora.sh",
        "pseudo_dir": "${E4_QE_PSEUDO_DIR}",
        "pseudopotentials": {
          "Si": "Si_r.upf"
        },
        "kpts": [
          4,
          4,
          4
        ],
        "koffset": [
          0,
          0,
          0
        ],
        "occupations": "smearing",
        "smearing": "gaussian",
        "degauss_ry": 0.007,
        "timeout_sec": 1800
      }
    },
    "frontier": {
      "backend": "qe",
      "qe": {
        "pw_bin": "${E4_QE_PW_BIN}",
        "pw_wrapper": "deployments/frontier/launchers/_qe-step-frontier.sh",
        "pseudo_dir": "${E4_QE_PSEUDO_DIR}",
        "pseudopotentials": {
          "Si": "Si_r.upf"
        },
        "kpts": [
          4,
          4,
          4
        ],
        "koffset": [
          0,
          0,
          0
        ],
        "occupations": "smearing",
        "smearing": "gaussian",
        "degauss_ry": 0.007,
        "timeout_sec": 1800
      }
    },
    "perlmutter": {
      "backend": "qe",
      "qe": {
        "pw_bin": "${E4_QE_PW_BIN}",
        "pw_wrapper": "deployments/perlmutter/launchers/_qe-step-perlmutter.sh",
        "pseudo_dir": "${E4_QE_PSEUDO_DIR}",
        "pseudopotentials": {
          "Si": "Si_r.upf"
        },
        "kpts": [
          4,
          4,
          4
        ],
        "koffset": [
          0,
          0,
          0
        ],
        "occupations": "smearing",
        "smearing": "gaussian",
        "degauss_ry": 0.007,
        "timeout_sec": 1800
      }
    }
  },
  "resources": {
    "aurora": {
      "preset": "aurora",
      "pools": {
        "mlip": {
          "nodes": 1,
          "devices": "all"
        },
        "dft": {
          "nodes": "rest",
          "devices": "all",
          "nodes_per_job": 1,
          "ranks_per_device": 1
        }
      }
    },
    "frontier": {
      "preset": "frontier",
      "pools": {
        "mlip": {
          "nodes": 1,
          "devices": "all"
        },
        "dft": {
          "nodes": "rest",
          "devices": "all",
          "nodes_per_job": 1,
          "ranks_per_device": 1
        }
      }
    },
    "perlmutter": {
      "preset": "perlmutter-gpu",
      "pools": {
        "mlip": {
          "nodes": 1,
          "devices": "all"
        },
        "dft": {
          "nodes": "rest",
          "devices": "all",
          "nodes_per_job": 1,
          "ranks_per_device": 1
        }
      }
    }
  }
}
